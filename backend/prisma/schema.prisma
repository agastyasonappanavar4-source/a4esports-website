generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ScrimMode {
  BR
  CS
  SPECIAL
}

enum ScrimStatus {
  OPEN
  CLOSED
}

enum SlotTime {
  PM_3
  PM_6
  PM_9
  AM_12
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id            Int              @id @default(autoincrement())

  username      String           @unique
  email         String           @unique
  password      String
  isAdmin       Boolean          @default(false)

  inGameName    String?
  uid           String?
  avatar        String?
  phone         String?
  googleId      String?
  resetToken    String?
  resetTokenExpiry DateTime?

  registrations Registration[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Scrim {
  id              Int               @id @default(autoincrement())

  title           String
  mode            ScrimMode
  fee             Int
  date            DateTime
  image           String
  prizePool       String?           @default("TBD")
  rules           String            @db.Text
  maxTeams        Int

  status          ScrimStatus       @default(OPEN)

  slots           Slot[]
  registrations   Registration[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  image       String?
  scrimId     Int?
  isPopup     Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Slot {
  id              Int               @id @default(autoincrement())

  time            SlotTime
  customTime      String?           // Admin-configurable timing (e.g. "3:00 PM", "5:00 PM", etc.)
  status          ScrimStatus       @default(OPEN)
  maxTeams        Int?

  roomId          String?
  roomPassword    String?
  roomReleased    Boolean           @default(false)

  scrimId         Int
  scrim           Scrim             @relation(fields: [scrimId], references: [id], onDelete: Cascade)

  registrations   Registration[]
  matches         Match[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([scrimId, time])
}

model Registration {
  id               Int              @id @default(autoincrement())

  registrationCode String           @unique

  teamName         String
  iglName          String
  phone            String           @db.VarChar(15)

  slotNumber       Int

  paymentStatus    PaymentStatus    @default(PENDING)
  paymentVerificationRequestedAt DateTime?
  paymentVerifiedAt DateTime?
  verifiedByAdminId Int?
  rejectionReason  String?

  userId           Int?
  user             User?            @relation(fields: [userId], references: [id])

  scrimId          Int
  scrim            Scrim            @relation(fields: [scrimId], references: [id])

  slotId           Int
  slot             Slot             @relation(fields: [slotId], references: [id])

  payment          Payment?
  matchResults     MatchResult[]

  createdAt        DateTime         @default(now())

  @@unique([userId, scrimId, slotId])
}

model Payment {
  id               Int              @id @default(autoincrement())

  registrationId   Int              @unique
  registration     Registration     @relation(fields: [registrationId], references: [id])

  amount           Int
  method           String
  transactionId    String           @unique

  status           PaymentStatus

  paidAt           DateTime         @default(now())
}

model Match {
  id              Int               @id @default(autoincrement())
  slotId          Int
  slot            Slot              @relation(fields: [slotId], references: [id], onDelete: Cascade)

  matchNumber     Int               @default(1)
  title           String?           // e.g. "Match 1", "Match 2"
  status          String            @default("COMPLETED")

  results         MatchResult[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([slotId])
}

model MatchResult {
  id              Int               @id @default(autoincrement())
  matchId         Int
  match           Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)

  registrationId  Int
  registration    Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  rank            Int
  won             Int               @default(0)
  pp              Int               @default(0)
  kp              Int               @default(0)
  tp              Int               @default(0)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([matchId, registrationId])
  @@index([matchId])
  @@index([registrationId])
}