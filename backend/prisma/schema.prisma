generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ScrimMode {
  BR
  CS
}

enum ScrimStatus {
  OPEN
  CLOSED
}

enum SlotTime {
  PM_3
  PM_6
  PM_9
  AM_12
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id            Int              @id @default(autoincrement())

  username      String           @unique
  email         String           @unique
  password      String
  isAdmin       Boolean          @default(false)

  registrations Registration[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Scrim {
  id              Int               @id @default(autoincrement())

  title           String
  mode            ScrimMode
  fee             Int
  date            DateTime
  image           String
  rules           String            @db.Text
  maxTeams        Int

  status          ScrimStatus       @default(OPEN)

  slots           Slot[]
  registrations   Registration[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Slot {
  id              Int               @id @default(autoincrement())

  time            SlotTime
  status          ScrimStatus       @default(OPEN)
  maxTeams        Int?

  roomId          String?
  roomPassword    String?
  roomReleased    Boolean           @default(false)

  scrimId         Int
  scrim           Scrim             @relation(fields: [scrimId], references: [id], onDelete: Cascade)

  registrations   Registration[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([scrimId, time])
}

model Registration {
  id               Int              @id @default(autoincrement())

  registrationCode String           @unique

  teamName         String
  iglName          String
  phone            String           @db.VarChar(15)

  slotNumber       Int

  paymentStatus    PaymentStatus    @default(PENDING)

  userId           Int?
  user             User?            @relation(fields: [userId], references: [id])

  scrimId          Int
  scrim            Scrim            @relation(fields: [scrimId], references: [id])

  slotId           Int
  slot             Slot             @relation(fields: [slotId], references: [id])

  payment          Payment?

  createdAt        DateTime         @default(now())
}

model Payment {
  id               Int              @id @default(autoincrement())

  registrationId   Int              @unique
  registration     Registration     @relation(fields: [registrationId], references: [id])

  amount           Int
  method           String
  transactionId    String           @unique

  status           PaymentStatus

  paidAt           DateTime         @default(now())
}