# Backend Environment Variables Template

# Database connection URL
DATABASE_URL="mysql://username:password@localhost:3306/ff_scrims"

# Secret key for JWT signing
JWT_SECRET="your_jwt_secret_key"

# Razorpay Keys
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Server Port
PORT=5000

# Google OAuth Credentials (must match Google Cloud Console)
GOOGLE_CLIENT_ID=1037872544242-tgvga3oiufl0j8un4df0tnfusu628vj8.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Redirect URI for Google OAuth callbacks
# Local Development: http://localhost:5000/api/auth/google/callback
# Production: https://a4esports-website.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# URL of the frontend application (CORS origin configuration)
# Local Development: http://localhost:3000
# Production: https://a4esports-website.vercel.app
FRONTEND_URL="http://localhost:3000"
